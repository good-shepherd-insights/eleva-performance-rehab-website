---
import type { Page } from "../lib/payload";

interface Props {
  itemList: Extract<Page["sections"][number], { blockType: "itemList" }>["itemList"];
  pathPrefix?: string;
}

const { itemList, pathPrefix = "" } = Astro.props;
const path = (suffix: string) => pathPrefix ? `${pathPrefix}.itemList.${suffix}` : `itemList.${suffix}`;
const allHref = itemList.allHref.trim();
---

<section class="gc-shell gc-item-list" id={pathPrefix ? `item-list-${pathPrefix}` : "item-list"}>
  <div class="gc-item-list-header">
    <div>
      <p class="gc-kicker" data-inline-edit={path("kicker")}>{itemList.kicker}</p>
      <h2 class="gc-heading-xl" data-inline-edit={path("heading")}>{itemList.heading}</h2>
    </div>
    <p class="gc-item-list-header-copy" data-inline-edit={path("intro")}>{itemList.intro}</p>
  </div>
  <ul class="gc-item-grid">
    {
      itemList.items.map((item, index) => (
          <li class="gc-item">
            <article class="gc-item-card">
              <span class="gc-item-tag" data-inline-edit={path(`items.${index}.tag`)}>{item.tag}</span>
              <h3 class="gc-item-title" data-inline-edit={path(`items.${index}.title`)}>{item.title}</h3>
              <div class="gc-item-meta">
                <span data-inline-edit={path(`items.${index}.detail`)}>{item.detail}</span>
              </div>
              <a
                class="gc-item-link"
                href={item.href}
                aria-label={item.viewAriaLabel.replace("{title}", item.title)}
              >
                <span data-inline-edit={path(`items.${index}.viewLabel`)}>{item.viewLabel}</span> <span aria-hidden="true">↗</span>
              </a>
            </article>
          </li>
      ))
    }
  </ul>
  <div class="gc-item-list-footer">
    <a class="gc-text-link" href={allHref}>
      <span data-inline-edit={path("allLabel")}>{itemList.allLabel}</span> <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>