---
import type { Page } from "../lib/payload";

interface Props {
  callToAction: Extract<Page["sections"][number], { blockType: "callToAction" }>["callToAction"];
  pathPrefix?: string;
}

const { callToAction, pathPrefix = "" } = Astro.props;
const path = (suffix: string) => pathPrefix ? `${pathPrefix}.callToAction.${suffix}` : `callToAction.${suffix}`;
---

<section class="gc-shell gc-call-to-action">
  <p class="gc-kicker" data-inline-edit={path("kicker")}>{callToAction.kicker}</p>
  <h2 class="gc-heading-xl gc-call-to-action-heading">
    <span data-inline-edit={path("headingTop")}>{callToAction.headingTop}</span><br /><span data-inline-edit={path("headingBottom")}>{callToAction.headingBottom}</span>
  </h2>
  <a class="gc-primary-action" href={callToAction.href}>
    <span data-inline-edit={path("ctaLabel")}>{callToAction.ctaLabel}</span> <span aria-hidden="true">↗</span>
  </a>
</section>