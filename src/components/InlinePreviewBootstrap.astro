---
import type { SiteGlobals, Page } from "../lib/payload";

interface Props {
  collection?: "globals" | "pages";
  id?: string | number;
  initialData: SiteGlobals | Page;
  initialGlobalData?: SiteGlobals;
  locale: string;
  globalSlug: string;
}

const { collection = "globals", id, initialData, initialGlobalData, locale, globalSlug } = Astro.props;
const config = JSON.stringify({ collection, id, initialData, initialGlobalData, locale, globalSlug });
---
{/*
  Previously this data was passed to the bootstrap script via
  `<script is:inline define:vars={{ ... }}>`. That combination is broken:
  `is:inline` scripts get zero processing from Astro/Vite (no bundling, no
  TypeScript stripping, no `import` resolution), but the script also used a
  real `import` statement and a TS generic (`querySelector<HTMLElement>`).
  Every browser threw `SyntaxError: Cannot use import statement outside a
  module` on load, so `initInlinePreview()` never ran and inline editing did
  nothing — no cursor, no typing, no save.

  Fix: drop `is:inline`/`define:vars` (which forced the no-processing mode)
  and pass the data through a plain HTML attribute instead, read back with
  `JSON.parse` inside a normal (Vite-processed, `type="module"`) script. That
  restores real `import` resolution and TypeScript stripping. Confirmed fixed
  by inspecting the actual served script (no more raw generic syntax, the
  import resolves to a real 200 URL) and by the browser console showing the
  SyntaxError gone after reload.
*/}
<div data-inline-preview-config={config} hidden></div>

<script>
  import { initInlinePreview } from "../lib/inline-preview";

  const configEl = document.querySelector<HTMLElement>("[data-inline-preview-config]");
  const embedded = window.parent !== window || Boolean(window.opener);

  if (configEl && embedded && document.referrer) {
    const { collection, id, initialData, initialGlobalData, locale, globalSlug } =
      JSON.parse(configEl.dataset.inlinePreviewConfig!);
    const serverURL = new URL(document.referrer).origin;
    initInlinePreview({ serverURL, locale, initialData, initialGlobalData, collection, id, globalSlug });
  }
</script>
