---
import type { Page } from "../lib/payload";

interface Props {
  highlights: Extract<Page["sections"][number], { blockType: "highlights" }>["highlights"];
  accessibility: {
    programSummaryLabel: string;
  };
  pathPrefix?: string;
}

const { highlights, accessibility, pathPrefix = "" } = Astro.props;
const path = (index: number) => pathPrefix ? `${pathPrefix}.highlights.items.${index}.label` : `highlights.items.${index}.label`;
---

<section class="gc-shell gc-highlights" aria-label={accessibility.programSummaryLabel}>
  {
    highlights.items.map((item, index) => (
      <>
      <p data-inline-edit={path(index)}>{item.label}</p>
        {index < highlights.items.length - 1 && (
          <i class="gc-highlights-divider" aria-hidden="true" />
        )}
      </>
    ))
  }
</section>