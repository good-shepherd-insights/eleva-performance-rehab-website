---
import type { Page } from "../lib/payload";

interface Props {
  mediaFeature: Extract<Page["sections"][number], { blockType: "mediaFeature" }>["mediaFeature"];
  pathPrefix?: string;
}

const { mediaFeature, pathPrefix = "" } = Astro.props;
const path = (suffix: string) => pathPrefix ? `${pathPrefix}.mediaFeature.${suffix}` : `mediaFeature.${suffix}`;
const linkHref = mediaFeature.linkHref.trim();
---

<section class="gc-shell gc-media-feature" id={pathPrefix ? `media-feature-${pathPrefix}` : "media-feature"}>
  <div class="gc-media-feature-photo">
    <img
      src={mediaFeature.photo.url}
      alt={mediaFeature.photoAlt}
      width={mediaFeature.photo.width}
      height={mediaFeature.photo.height}
      loading="lazy"
      decoding="async"
      data-live-sync-src={path("photo.url")}
      data-live-sync-alt={path("photoAlt")}
    />
  </div>
  <div class="gc-media-feature-copy">
    <p class="gc-kicker" data-inline-edit={path("kicker")}>{mediaFeature.kicker}</p>
    <h2 class="gc-heading-xl gc-media-feature-heading">
      <span data-inline-edit={path("headingTop")}>{mediaFeature.headingTop}</span><br /><span data-inline-edit={path("headingBottom")}>{mediaFeature.headingBottom}</span>
    </h2>
    <ol class="gc-media-feature-steps">
      {
        mediaFeature.steps.map((step, index) => (
          <li class="gc-media-feature-step" key={step.number}>
            <span class="gc-media-feature-step-number" data-inline-edit={path(`steps.${index}.number`)}>{step.number}</span>
            <div>
              <h3 class="gc-media-feature-step-title" data-inline-edit={path(`steps.${index}.title`)}>{step.title}</h3>
              <p class="gc-media-feature-step-body" data-inline-edit={path(`steps.${index}.body`)}>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <a class="gc-text-link" href={linkHref}>
      <span data-inline-edit={path("linkLabel")}>{mediaFeature.linkLabel}</span> <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>