---
import type { SiteGlobals } from "../lib/payload";

interface Props {
  brand: SiteGlobals["brand"];
  footer: SiteGlobals["footer"];
}

const { brand, footer } = Astro.props;
---

<footer class="gc-shell gc-footer">
  <div
    class="gc-logo gc-logo-img"
    role="img"
    aria-label={brand.logoAlt}
    style={`background-image:url(${brand.logo.url})`}
    data-live-sync-bg="brand.logo.url"
    data-live-sync-alt="brand.logoAlt"
  ></div>
  <p class="gc-footer-tagline" data-inline-edit="footer.tagline">{footer.tagline}</p>
  <div class="gc-footer-links">
    {footer.links.map((link, index) => (
        <a href={link.href} data-inline-edit={`footer.links.${index}.label`}>{link.label}</a>
      ))}
  </div>
  <p class="gc-footer-note" data-inline-edit="footer.note">{footer.note}</p>
</footer>
