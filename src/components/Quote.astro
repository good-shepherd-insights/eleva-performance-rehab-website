---
import type { Page } from "../lib/payload";

interface Props {
  quote: Extract<Page["sections"][number], { blockType: "quote" }>["quote"];
  pathPrefix?: string;
}

const { quote, pathPrefix = "" } = Astro.props;
const path = (suffix: string) => pathPrefix ? `${pathPrefix}.quote.${suffix}` : `quote.${suffix}`;
---

<figure class="gc-shell gc-quote-section">
  <div class="gc-quote-index">&ldquo;</div>
  <blockquote class="gc-quote-text" data-inline-edit={path("quote")}>{quote.quote}</blockquote>
  <figcaption class="gc-quote-attribution" data-inline-edit={path("attribution")}>{quote.attribution}</figcaption>
</figure>