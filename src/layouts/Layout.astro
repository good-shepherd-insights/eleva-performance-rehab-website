---
import "../styles/global.css";
import { SEO } from "astro-seo";
import { getAbsoluteLocaleUrlList, toCodes } from "astro:i18n";
import { i18n } from "astro:config/client";
import { serializeJsonLd } from "../lib/seo/serializer";

interface Props {
  title: string;
  description: string;
  locale: string;
  favicon?: string;
  image: string;
  imageAlt: string;
  jsonLd: unknown;
}

const {
  title,
  description,
  locale,
  favicon = "/favicon.svg",
  image,
  imageAlt,
  jsonLd,
} = Astro.props;
const siteOrigin = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);

// Locale list comes from astro.config.mjs's i18n config, which is itself
// discovered from Payload at build time — no locale is ever hardcoded here.
// getAbsoluteLocaleUrlList()'s output is guaranteed to be in the same order
// as toCodes(i18n.locales) (both derive from the same underlying array).
if (!i18n) {
  throw new Error("astro:config/client has no i18n config — check astro.config.mjs's i18n block.");
}
const localeCodes = toCodes(i18n.locales);
const localeUrls = getAbsoluteLocaleUrlList();
const defaultLocaleIndex = i18n.defaultLocale ? localeCodes.indexOf(i18n.defaultLocale) : 0;
const languageAlternates = [
  ...localeCodes.map((code, index) => ({ href: localeUrls[index], hrefLang: code })),
  { href: localeUrls[defaultLocaleIndex], hrefLang: "x-default" },
];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={favicon} />
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      languageAlternates={languageAlternates}
      openGraph={{
        basic: {
          title,
          type: "website",
          image,
          url: canonicalURL.toString(),
        },
        optional: {
          description,
          // og:locale's canonical shape is language_TERRITORY, but Payload's
          // locale config has no territory data — fabricating one (e.g.
          // "ko_KR") isn't available for an arbitrary future locale, so this
          // uses the bare language code rather than guessing a territory.
          locale,
        },
        image: { alt: imageAlt },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image,
        imageAlt,
      }}
    />
    <script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
